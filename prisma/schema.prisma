// Albi adatmodell — 1. mérföldkő: gerinc és befizetés-egyeztetés.
//
// Pénzösszegek egész forintban (Int). A forintnak nincs gyakorlati váltópénze,
// így nincs lebegőpontos kerekítési hiba sem.
//
// Fejlesztéshez és a próbakörnyezethez SQLite. Az éles adatbázis PostgreSQL lesz
// EU-s régióban; amíg nincs éles adat, a váltás egyetlen migráció újrafuttatása.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Felhasznalo {
  id         String   @id @default(cuid())
  email      String   @unique
  nev        String
  jelszoHash String
  szerep     String // "berbeado" | "berlo"
  nyelv      String   @default("hu") // "hu" | "en" — a bérlői oldal kétnyelvű
  letrehozva DateTime @default(now())

  ingatlanok          Ingatlan[]
  berloJogviszonyai   JogviszonyBerlo[]   @relation("BerloJogviszonyai")
  berbeadoiIgazolasai BerbeadoiIgazolas[]
  teendoi             Teendo[]
  oraallasai          Oraallas[]
  beallitasok         Beallitasok?
  berbeadoiAdatok     BerbeadoiAdatok?
  hibabejelentesei    Hibabejelentes[]    @relation("Hibabejelentesei")
  hibaUzenetei        HibaUzenet[]        @relation("HibaUzenetei")
  betekintoi          Betekinto[]         @relation("Betekintoi")
}

/// Bérbeadónkénti egyeztetési beállítások. Az összegtolerancia szándékosan nincs
/// itt: az a termékdöntés szerint fix nulla, minden eltérésnél egyeztetés indul.
model Beallitasok {
  id              String   @id @default(cuid())
  berbeadoId      String   @unique
  korabbiAblakNap Int      @default(10) // ennyi nappal az esedékesség előtt már elfogadjuk
  kesobbiAblakNap Int      @default(25) // ennyi nappal utána még ehhez az előíráshoz kötjük
  frissitve       DateTime @updatedAt

  berbeado Felhasznalo @relation(fields: [berbeadoId], references: [id], onDelete: Cascade)
}

model Ingatlan {
  id                   String    @id @default(cuid())
  tulajdonosId         String
  megnevezes           String
  cim                  String
  alapteruletM2        Int?
  // A szerződéshez kell: a bérlemény azonosítása a tulajdoni lap szerint.
  helyrajziSzam        String?
  // Jogszabály szerint a bérbeadónak át kell adnia; a szerződés hivatkozik rá.
  energetikaiAzonosito String?
  kozosKoltsegFt       Int?
  // Az értékcsökkenés alapja. Enélkül a tételes adóelszámolás hiányos.
  beszerzesiArFt       Int?
  beszerzesDatuma      DateTime?
  letrehozva           DateTime  @default(now())

  tulajdonos   Felhasznalo  @relation(fields: [tulajdonosId], references: [id], onDelete: Cascade)
  meroorak     Meroora[]
  jogviszonyok Jogviszony[]
  koltsegek    Koltseg[]

  @@index([tulajdonosId])
}

model Meroora {
  id           String   @id @default(cuid())
  ingatlanId   String
  tipus        String // "villany" | "viz" | "gaz" | "futes"
  gyariSzam    String?
  mertekegyseg String // "kWh" | "m3" | "GJ"
  almero       Boolean  @default(false)
  letrehozva   DateTime @default(now())

  ingatlan           Ingatlan           @relation(fields: [ingatlanId], references: [id], onDelete: Cascade)
  oraallasok         Oraallas[]
  dijszabasok        Dijszabas[]
  tetelek            ElszamolasTetel[]
  jegyzokonyvTetelek JegyzokonyvTetel[]

  @@index([ingatlanId])
}

model Oraallas {
  id          String   @id @default(cuid())
  merooraId   String
  datum       DateTime
  ertek       Float
  fotoUtvonal String?
  rogzitoId   String
  letrehozva  DateTime @default(now())

  meroora Meroora     @relation(fields: [merooraId], references: [id], onDelete: Cascade)
  rogzito Felhasznalo @relation(fields: [rogzitoId], references: [id])

  @@index([merooraId, datum])
}

/// Egy mérőóra díjszabása, érvényességi kezdőnappal, hogy az áremelés ne írja
/// felül a korábbi elszámolásokat.
///
/// Az egységár fillérben, egészben: a rezsiárak nem kerek forintok (36,9 Ft/kWh),
/// és a lebegőpontos szorzás pont a pénznél téved. Forintra csak a tétel végén
/// kerekítünk.
model Dijszabas {
  id                   String   @id @default(cuid())
  merooraId            String
  ervenyesTol          DateTime
  kedvezmenyesArFiller Int
  piaciArFiller        Int
  evesKeret            Float? // egység/év; null: nincs sáv, minden egység a kedvezményes áron
  alapdijFt            Int      @default(0) // havi alapdíj
  letrehozva           DateTime @default(now())

  meroora Meroora @relation(fields: [merooraId], references: [id], onDelete: Cascade)

  @@index([merooraId, ervenyesTol])
}

model Jogviszony {
  id              String    @id @default(cuid())
  ingatlanId      String
  kezdete         DateTime
  vege            DateTime?
  berletiDijFt    Int
  kozosKoltsegFt  Int       @default(0)
  kaucioFt        Int       @default(0)
  fizetesiNap     Int       @default(5) // a hónap hányadikára esedékes
  rezsiElszamolas String    @default("almero") // "almero" | "atalany" | "kozos_koltsegben"
  rezsiAtalanyFt  Int       @default(0) // havi átalány, ha a rezsi átalányban megy
  statusz         String    @default("elo") // "elo" | "lezart"
  letrehozva      DateTime  @default(now())

  ingatlan            Ingatlan            @relation(fields: [ingatlanId], references: [id], onDelete: Cascade)
  berlok              JogviszonyBerlo[]
  eloirtTetelek       EloirtTetel[]
  berloiIgazolasok    BerloiIgazolas[]
  berbeadoiIgazolasok BerbeadoiIgazolas[]
  egyeztetesek        Egyeztetes[]
  elszamolasok        Elszamolas[]
  teendok             Teendo[]
  szerzodesek         Szerzodes[]
  jegyzokonyvek       Jegyzokonyv[]
  hibabejelentesek    Hibabejelentes[]
  betekintok          Betekinto[]

  @@index([ingatlanId])
}

/// Egy jogviszonyhoz több bérlő is tartozhat: diáktársak, élettársak, házaspár.
/// A Ptk. szerint a fizetési kötelezettségért egyetemlegesen felelnek, bármelyikük
/// teljesítése a teljesítés mértékéig a többit is mentesíti. Ezért a
/// befizetés-egyeztetés továbbra is a jogviszony szintjén dolgozik: egy 150 000 Ft-os
/// bérleti díj egy előírás, akárhányan is utalják.
///
/// A személyes adatok (születési adatok, anyja neve, igazolványszám) csak a
/// szerződés és az igazolások kiállításához kellenek. Naplóba egyik sem kerül.
model JogviszonyBerlo {
  id             String    @id @default(cuid())
  jogviszonyId   String
  berloId        String? // ha már van fiókja
  nev            String
  email          String?
  szuletesiHely  String?
  szuletesiIdo   DateTime?
  anyjaNeve      String?
  lakcim         String?
  igazolvanySzam String?
  // Sürgős hibánál a bérbeadó ezen éri el; a szerződés kapcsolattartási pontja is ezt írja.
  telefon        String?
  sorrend        Int       @default(0)
  letrehozva     DateTime  @default(now())

  jogviszony Jogviszony   @relation(fields: [jogviszonyId], references: [id], onDelete: Cascade)
  berlo      Felhasznalo? @relation("BerloJogviszonyai", fields: [berloId], references: [id])
  meghivok   Meghivo[]
  igazolasok Igazolas[]

  @@index([jogviszonyId, sorrend])
  @@index([berloId])
}

/// A bérbeadó szerződéshez kellő adatai. Külön táblában, mert a belépéshez
/// egyikük sem kell, így a bejelentkezési út nem is olvassa őket.
model BerbeadoiAdatok {
  id             String    @id @default(cuid())
  berbeadoId     String    @unique
  szuletesiHely  String?
  szuletesiIdo   DateTime?
  anyjaNeve      String?
  lakcim         String?
  igazolvanySzam String?
  adoazonosito   String?
  // Veszélyhelyzetben a bérlő ezt látja a hibabejelentés mellett.
  telefon        String?
  bankszamla     String?
  bank           String?
  frissitve      DateTime  @updatedAt

  berbeado Felhasznalo @relation(fields: [berbeadoId], references: [id], onDelete: Cascade)
}

/// A bérlő meghívása a saját oldalára. A bérbeadó hozza létre, a bérlő ebből
/// regisztrál. Egy meghívó egyszer használható, és lejár.
model Meghivo {
  id                String    @id @default(cuid())
  jogviszonyBerloId String
  token             String    @unique
  email             String
  lejar             DateTime
  felhasznalva      DateTime?
  letrehozva        DateTime  @default(now())

  jogviszonyBerlo JogviszonyBerlo @relation(fields: [jogviszonyBerloId], references: [id], onDelete: Cascade)

  @@index([jogviszonyBerloId])
}

/// Amit fizetni kellett volna: a rendszer írja elő, és soha nem a befizetés írja felül.
model EloirtTetel {
  id           String   @id @default(cuid())
  jogviszonyId String
  tipus        String // "berleti_dij" | "kozos_koltseg" | "rezsi_atalany" | "egyeb"
  idoszak      String // "2026-09"
  esedekesseg  DateTime
  osszegFt     Int
  // Miért ennyi, ha nem a teljes havi összeg (töredékhónap). Szótárkulcs és
  // adatok JSON-ként: a magyarázat a nyelvvel együtt változik.
  reszletezes  String?
  letrehozva   DateTime @default(now())

  jogviszony          Jogviszony          @relation(fields: [jogviszonyId], references: [id], onDelete: Cascade)
  egyeztetes          Egyeztetes?
  elszamolas          Elszamolas?
  berbeadoiIgazolasok BerbeadoiIgazolas[]

  @@unique([jogviszonyId, tipus, idoszak])
  @@index([esedekesseg])
}

/// Amit a bérlő mond: mikor mennyit utalt. Bizonyíték is lehet mellette.
model BerloiIgazolas {
  id              String   @id @default(cuid())
  jogviszonyId    String
  utalasDatuma    DateTime
  osszegFt        Int
  kozlemeny       String?
  igazolasUtvonal String?
  rogzitve        DateTime @default(now())

  jogviszony Jogviszony  @relation(fields: [jogviszonyId], references: [id], onDelete: Cascade)
  egyeztetes Egyeztetes?

  @@index([jogviszonyId, utalasDatuma])
}

/// Amit a bankszámlakivonat mutat: egy sor a feltöltött kivonatból.
model BerbeadoiIgazolas {
  id            String   @id @default(cuid())
  tulajdonosId  String
  jogviszonyId  String
  // Igaz: "ennyi érkezett ekkor". Hamis: "erre az előírásra nem érkezett pénz".
  // A tagadás mindig egy előíráshoz tartozik, ezért van hozzá eloirtTetelId.
  megerkezett   Boolean  @default(true)
  eloirtTetelId String?
  erkezesDatuma DateTime
  osszegFt      Int      @default(0)
  kozlemeny     String?
  rogzitve      DateTime @default(now())

  tulajdonos  Felhasznalo  @relation(fields: [tulajdonosId], references: [id], onDelete: Cascade)
  jogviszony  Jogviszony   @relation(fields: [jogviszonyId], references: [id], onDelete: Cascade)
  eloirtTetel EloirtTetel? @relation(fields: [eloirtTetelId], references: [id], onDelete: Cascade)
  egyeztetes  Egyeztetes?

  // Egy előírásra egy tagadás elég; a tagadást a beérkezés rögzítése váltja fel.
  @@unique([eloirtTetelId])
  @@index([tulajdonosId, erkezesDatuma])
  @@index([jogviszonyId, erkezesDatuma])
}

/// A három adat összevetésének eredménye. Ez az, amit mindkét fél lát.
model Egyeztetes {
  id                  String   @id @default(cuid())
  jogviszonyId        String
  eloirtTetelId       String?  @unique
  berloiIgazolasId    String?  @unique
  berbeadoiIgazolasId String?  @unique
  allapot             String // "egyezik" | "elter" | "vitas" | "varakozik" | "hianyzik"
  elteresOka          String? // "osszeg" | "ket_oldal_elter" | "nincs_berbeadoi_igazolas" | "nincs_berloi_igazolas" | "nincs_eloiras"
  elteresFt           Int      @default(0)
  keses               Int      @default(0) // naptári nap, negatív, ha korábban érkezett
  frissitve           DateTime @updatedAt

  jogviszony        Jogviszony         @relation(fields: [jogviszonyId], references: [id], onDelete: Cascade)
  eloirtTetel       EloirtTetel?       @relation(fields: [eloirtTetelId], references: [id])
  berloiIgazolas    BerloiIgazolas?    @relation(fields: [berloiIgazolasId], references: [id])
  berbeadoiIgazolas BerbeadoiIgazolas? @relation(fields: [berbeadoiIgazolasId], references: [id])

  @@index([jogviszonyId, allapot])
}

/// Egy időszak rezsielszámolása. Tételesen áll össze, hogy a bérlő
/// ellenőrizni tudja, ne csak elhinni.
model Elszamolas {
  id             String    @id @default(cuid())
  jogviszonyId   String
  idoszakKezdete DateTime
  idoszakVege    DateTime
  allapot        String    @default("tervezet") // "tervezet" | "kiadva" | "elfogadva" | "vitatott"
  osszegFt       Int
  eloirtTetelId  String?   @unique
  berloiUzenet   String? // amit a bérlő írt, ha vitatja
  kiadva         DateTime?
  lezarva        DateTime?
  letrehozva     DateTime  @default(now())

  jogviszony  Jogviszony        @relation(fields: [jogviszonyId], references: [id], onDelete: Cascade)
  eloirtTetel EloirtTetel?      @relation(fields: [eloirtTetelId], references: [id])
  tetelek     ElszamolasTetel[]

  @@index([jogviszonyId, idoszakVege])
}

/// Az elszámolás egy sora. A részletezés emberi nyelven mondja el, miből jött
/// ki az összeg, mert a bérlő ezt fogja elolvasni.
model ElszamolasTetel {
  id           String  @id @default(cuid())
  elszamolasId String
  merooraId    String?
  fajta        String // "meroora" | "alapdij" | "atalany" | "kozos_koltseg"
  megnevezes   String
  mennyiseg    Float?
  mertekegyseg String?
  reszletezes  String
  osszegFt     Int
  sorrend      Int     @default(0)

  elszamolas Elszamolas @relation(fields: [elszamolasId], references: [id], onDelete: Cascade)
  meroora    Meroora?   @relation(fields: [merooraId], references: [id])

  @@index([elszamolasId])
}

/// A bérbeadás költségei a tételes adóelszámoláshoz. Az értékcsökkenést nem itt
/// tároljuk: az az ingatlan beszerzési árából számolódik évről évre.
model Koltseg {
  id            String   @id @default(cuid())
  ingatlanId    String
  datum         DateTime
  fajta         String // "felujitas" | "kozos_koltseg" | "biztositas" | "kozuzem" | "egyeb"
  megnevezes    String
  osszegFt      Int
  szamlaUtvonal String?
  letrehozva    DateTime @default(now())

  ingatlan Ingatlan @relation(fields: [ingatlanId], references: [id], onDelete: Cascade)

  @@index([ingatlanId, datum])
}

/// Minden modul ide termel. Ebből épül a kezdőlap kiemelt sávja és a naptár.
model Teendo {
  id           String   @id @default(cuid())
  cimzettId    String
  jogviszonyId String?
  tipus        String // "befizetes_esedekes" | "eltereses_befizetes" | "kivonat_feltoltes" | "oraallas_bekeres" | ...
  cim          String
  leiras       String?
  esedekesseg  DateTime
  hivatkozas   String?
  statusz      String   @default("nyitott") // "nyitott" | "kesz"
  kulcs        String   @unique // idempotencia: ugyanaz a teendő ne szülessen meg kétszer
  letrehozva   DateTime @default(now())

  cimzett    Felhasznalo @relation(fields: [cimzettId], references: [id], onDelete: Cascade)
  jogviszony Jogviszony? @relation(fields: [jogviszonyId], references: [id], onDelete: Cascade)

  @@index([cimzettId, statusz, esedekesseg])
}

/// Egy jogviszony bérleti szerződése. A szöveg nem itt tárolódik, hanem a
/// modulkatalógusból (`src/domain/szerzodes-modulok.ts`) áll össze a választott
/// modulokból és a megadott paraméterekből. Így egy szövegjavítás minden
/// tervezetre azonnal érvényesül.
///
/// Véglegesítéskor viszont a teljes szöveget befagyasztjuk: amit a felek
/// aláírtak, azt egy későbbi modulfrissítés nem írhatja át.
model Szerzodes {
  id             String    @id @default(cuid())
  jogviszonyId   String
  megnevezes     String
  allapot        String    @default("tervezet") // "tervezet" | "veglegesitve"
  kelteHelye     String    @default("")
  kelte          DateTime?
  veglegesSzoveg String?
  veglegesitve   DateTime?
  letrehozva     DateTime  @default(now())
  frissitve      DateTime  @updatedAt

  jogviszony  Jogviszony           @relation(fields: [jogviszonyId], references: [id], onDelete: Cascade)
  modulok     SzerzodesModul[]
  parameterek SzerzodesParameter[]

  @@index([jogviszonyId])
}

/// Egy szerződésbe bekapcsolt modul. Csak a bekapcsoltak kerülnek sorba; a
/// katalógusban lévő többi modul választható marad.
model SzerzodesModul {
  id          String @id @default(cuid())
  szerzodesId String
  kulcs       String
  sorrend     Int    @default(0)

  szerzodes Szerzodes @relation(fields: [szerzodesId], references: [id], onDelete: Cascade)

  @@unique([szerzodesId, kulcs])
}

/// Egy modul kitöltött paramétere. Szövegként tároljuk, mert a modul maga tudja,
/// hogy számot, dátumot vagy összeget vár; az értelmezés a domainben egy helyen van.
model SzerzodesParameter {
  id          String @id @default(cuid())
  szerzodesId String
  kulcs       String
  ertek       String

  szerzodes Szerzodes @relation(fields: [szerzodesId], references: [id], onDelete: Cascade)

  @@unique([szerzodesId, kulcs])
}

/// Átadás-átvételi jegyzőkönyv: mérőóraállások, kulcsok, állapot, hibák.
///
/// Ez a bérlet legfontosabb bizonyítéka. Enélkül a kiköltözéskor szó áll
/// szemben szóval arról, mi volt a lakásban és milyen állapotban.
///
/// Véglegesítéskor két dolog történik: a szöveg befagy, és a rögzített
/// óraállások bekerülnek a mérőórák történetébe. Az utóbbi azért fontos, mert
/// így a birtokbaadás állása lesz az első rezsielszámolás kiindulópontja, és
/// ugyanazt az adatot nem kell kétszer beírni.
model Jegyzokonyv {
  id             String    @id @default(cuid())
  jogviszonyId   String
  fajta          String // "birtokbaadas" | "visszaadas"
  idopont        DateTime
  allapotLeiras  String    @default("")
  megjegyzes     String?
  allapot        String    @default("tervezet") // "tervezet" | "veglegesitve"
  veglegesSzoveg String?
  veglegesitve   DateTime?
  letrehozva     DateTime  @default(now())

  jogviszony Jogviszony         @relation(fields: [jogviszonyId], references: [id], onDelete: Cascade)
  tetelek    JegyzokonyvTetel[]

  @@index([jogviszonyId, idopont])
}

/// A jegyzőkönyv egy sora. A hibákhoz felelős és határidő is tartozhat: abból
/// lesz teendő, hogy a „majd megcsináljuk” ne vesszen el.
model JegyzokonyvTetel {
  id            String    @id @default(cuid())
  jegyzokonyvId String
  fajta         String // "meroora" | "kulcs" | "hiba" | "dokumentum"
  merooraId     String?
  megnevezes    String
  ertek         String?
  megjegyzes    String?
  felelos       String? // "berbeado" | "berlo"
  hatarido      DateTime?
  sorrend       Int       @default(0)

  jegyzokonyv Jegyzokonyv @relation(fields: [jegyzokonyvId], references: [id], onDelete: Cascade)
  meroora     Meroora?    @relation(fields: [merooraId], references: [id])

  @@index([jegyzokonyvId, sorrend])
}

/// Bérbeadói igazolás egy bérlőnek: albérlettámogatáshoz, ösztöndíjhoz,
/// munkáltatói térítéshez kérik, jellemzően havonta.
///
/// Az összeget és a teljesítés napját nem kézzel írjuk be, hanem a párosított
/// befizetésből vesszük: az alkalmazás már tudja, melyik hónapra mennyi érkezett.
/// A kiállított igazolás szövegét elmentjük, mert az egy kiadott okirat.
model Igazolas {
  id                String   @id @default(cuid())
  jogviszonyBerloId String
  cel               String
  idoszak           String // "2026-09"
  osszegFt          Int
  teljesitesNapja   DateTime
  teljesitesModja   String // "atutalas" | "keszpenz" | "egyeb"
  szoveg            String
  kiallitva         DateTime @default(now())

  jogviszonyBerlo JogviszonyBerlo @relation(fields: [jogviszonyBerloId], references: [id], onDelete: Cascade)

  @@index([jogviszonyBerloId, idoszak])
}

/// Hibabejelentés: a bérlő jelzi, mi romlott el, a bérbeadó pedig végigviszi.
///
/// A bejelentés és az elhárítás két külön esemény, és egyik sem írja felül a
/// másikat: a bérbeadó jelöli elhárítottnak, a bérlő erősíti meg, hogy tényleg
/// rendben van. Ugyanaz a kétoldali elv, mint a befizetésnél.
///
/// A költségviselőre az alkalmazás javaslatot tesz a szerződés karbantartási
/// pontja alapján, de nem dönt helyette: a `viseloFel` csak akkor kerül bele,
/// ha a bérbeadó kimondta.
model Hibabejelentes {
  id           String    @id @default(cuid())
  jogviszonyId String
  bejelentoId  String
  targy        String
  leiras       String
  terulet      String // "epulet" | "kozponti_berendezes" | "kozos_terulet" | "burkolat" | "nyilaszaro" | "berendezes" | "haztartasi_gep" | "egyeb"
  ok           String    @default("ismeretlen") // "elhasznalodas" | "karokozas" | "ismeretlen"
  surgosseg    String // "veszhelyzet" | "surgos" | "normal"
  allapot      String    @default("bejelentve") // "bejelentve" | "atvette" | "folyamatban" | "elharitva" | "lezarva" | "elutasitva"
  viseloFel    String? // "berbeado" | "berlo" | "megosztott" — csak ha a bérbeadó kimondta
  bejelentve   DateTime  @default(now())
  atvetve      DateTime?
  elharitva    DateTime?
  lezarva      DateTime?

  jogviszony Jogviszony   @relation(fields: [jogviszonyId], references: [id], onDelete: Cascade)
  bejelento  Felhasznalo  @relation("Hibabejelentesei", fields: [bejelentoId], references: [id])
  uzenetek   HibaUzenet[]

  @@index([jogviszonyId, allapot])
}

/// A hibabejelentés beszélgetése. Külön sorokban, mert a két fél egymás
/// üzeneteit nem írhatja át, és utólag is látszik, ki mit ígért és mikor.
model HibaUzenet {
  id               String   @id @default(cuid())
  hibabejelentesId String
  szerzoId         String
  szoveg           String
  letrehozva       DateTime @default(now())

  hibabejelentes Hibabejelentes @relation(fields: [hibabejelentesId], references: [id], onDelete: Cascade)
  szerzo         Felhasznalo    @relation("HibaUzenetei", fields: [szerzoId], references: [id])

  @@index([hibabejelentesId, letrehozva])
}

/**
 * Betekintő: a bérlő által kiadott, csak olvasható nézet a fizetési
 * előzményeire. A bérlőszűrés jogilag korlátos, ez viszont a bérlő saját
 * döntése a saját adatáról, és onnan jön, amit a bérbeadó kivonata igazol.
 */
model Betekinto {
  id            String    @id @default(cuid())
  jogviszonyId  String
  berloId       String
  token         String    @unique
  /**
   * Mire kéri: "lakásbérléshez", "munkáltatónak". A bérlő írja be.
   */
  cel           String
  /**
   * Az összegek megjelenjenek-e. Alapból nem: a tény elég, a díj magánügy.
   */
  osszegetMutat Boolean   @default(false)
  lejar         DateTime
  visszavonva   DateTime?
  letrehozva    DateTime  @default(now())

  jogviszony  Jogviszony           @relation(fields: [jogviszonyId], references: [id], onDelete: Cascade)
  berlo       Felhasznalo          @relation("Betekintoi", fields: [berloId], references: [id], onDelete: Cascade)
  megnyitasok BetekintoMegnyitas[]

  @@index([berloId])
  @@index([jogviszonyId])
}

/**
 * Egy megnyitás ideje, és semmi más. IP-t és böngészőazonosítót szándékosan
 * nem tárolunk: a bérlőnek az számít, hányszor és mikor nézték meg.
 */
model BetekintoMegnyitas {
  id          String   @id @default(cuid())
  betekintoId String
  mikor       DateTime @default(now())

  betekinto Betekinto @relation(fields: [betekintoId], references: [id], onDelete: Cascade)

  @@index([betekintoId, mikor])
}
